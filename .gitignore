# =====================================================
# AIS Demo Project .gitignore
# =====================================================

# ---- Dependencies ----
node_modules/
jspm_packages/
bower_components/

# ---- Build output / cache ----
dist/
build/
out/
.cache/
.parcel-cache/
.vite/
.turbo/
.next/
.nuxt/
.npm-cache/
.yarn/cache/
.pnp.*

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- OS generated ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride

# ---- Editor / IDE ----
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Env & secrets ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
secrets.json

# ---- Temporary files ----
tmp/
temp/
*.tmp
*.bak
*.old
*.pid

# ---- Server / coverage ----
coverage/
.nyc_output/
server.pid
